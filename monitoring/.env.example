# ==============================================================================
# Observability & Monitoring Stack — Environment Variables Template
# ==============================================================================
# Copy this file to `.env` inside `monitoring/` ONLY for local development.
# NEVER commit `.env` or real production credentials/tokens to Git.
# ==============================================================================

# Grafana local-only dev credentials (change immediately if exposed beyond localhost)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme

# Prometheus configuration file:
#   - Local Docker stack (devops-net): ./prometheus/prometheus.yml
#   - Live Render Cloud HTTPS targets: ./prometheus/prometheus.render.yml
PROMETHEUS_CONFIG=./prometheus/prometheus.yml

# Prometheus TSDB retention window
PROMETHEUS_RETENTION=15d
