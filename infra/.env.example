# ==============================================================================
# Plantilla de variables de entorno para ejecución local con docker-compose.app.yml
# Copiar a `.env` en la raíz del proyecto (el archivo `.env` está ignorado por Git).
# NUNCA subir credenciales reales de Neon, Render ni bases de datos al repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# Puertos expuestos en host local (evitan colisión con Jenkins:8080 y SonarQube:9000)
# ------------------------------------------------------------------------------
API_PORT=8081
CLIENT_PORT=8082
LOCAL_POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Modo 1: Base de datos PostgreSQL local efímera (--profile local-db)
# ------------------------------------------------------------------------------
LOCAL_DB_NAME=neondb
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=changeme_local_only

# ------------------------------------------------------------------------------
# Modo 2: Conexión a Neon PostgreSQL Cloud (descomentar y reemplazar valores)
# Ejecutar SIN --profile local-db:
#   docker compose -f docker-compose.app.yml --env-file .env up -d --build
# ------------------------------------------------------------------------------
# DB_URL=jdbc:postgresql://<your-neon-host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# DB_USERNAME=<your-neon-username>
# DB_PASSWORD=<your-neon-password>

# ------------------------------------------------------------------------------
# Configuración JPA / Hikari / Comunicación inter-servicios
# ------------------------------------------------------------------------------
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
DB_POOL_MAX=5
API_BASE_URL=http://api-gestor:8081
